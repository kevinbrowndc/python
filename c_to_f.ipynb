        "def temp():\n",
        "  temp_f = input(\"Enter temperature in Farenheit: \")\n",
        "  x = int(temp_f)\n",
        "  temp_c = (x-32) * 5/9\n",
        "  print (temp_f + ' in Celcius is ' + str(temp_c))"
      ]
    },
